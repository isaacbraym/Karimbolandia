rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function owner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }
    function validSave() {
      let d = request.resource.data;
      return d.keys().hasAll(['v', 'revision', 'payload', 'previousPayload', 'updatedAt'])
        && d.keys().hasOnly(['v', 'revision', 'payload', 'previousPayload', 'updatedAt'])
        && d.v == 1 && d.revision is int && d.revision >= 1
        && d.payload is string && d.payload.size() <= 250000
        && d.previousPayload is string && d.previousPayload.size() <= 250000
        && d.updatedAt == request.time;
    }
    match /saves/{uid} {
      allow get: if owner(uid);
      allow list, delete: if false;
      allow create: if owner(uid) && validSave() && request.resource.data.revision == 1
        && request.resource.data.previousPayload == '';
      allow update: if owner(uid) && validSave()
        && request.resource.data.revision == resource.data.revision + 1
        && request.resource.data.previousPayload == resource.data.payload;
    }
  }
}
